# Copy this file to keystore.properties (same folder) and fill in your values.
# keystore.properties is gitignored and must NEVER be committed.
# Generate a keystore with:
#   keytool -genkeypair -v -keystore techhausa-release.jks -alias techhausa -keyalg RSA -keysize 2048 -validity 10000
storeFile=techhausa-release.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=techhausa
keyPassword=YOUR_KEY_PASSWORD
